{
  "name": "school-erp-backend",
  "version": "1.0.0",
  "description": "School ERP System - Backend API for Exam & Result Management",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "seed": "node prisma/seed.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_ENV=test jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules NODE_ENV=test jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules NODE_ENV=test jest --coverage",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules NODE_ENV=test jest --testPathPattern=unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules NODE_ENV=test jest --testPathPattern=integration"
  },
  "keywords": [
    "school-management",
    "exam-management",
    "result-management",
    "education",
    "erp"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.0",
    "winston": "^3.14.2",
    "xlsx": "^0.18.5",
    "xss-clean": "^0.1.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2"
  }
}